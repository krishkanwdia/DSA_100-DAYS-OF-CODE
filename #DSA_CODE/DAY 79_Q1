#include <stdio.h>

#define INF 1000000000
#define SIZE 105

int graph[SIZE][SIZE];
int dist[SIZE];
int visited[SIZE];

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    for (int i = 1; i <= n; i++) {
        dist[i] = INF;
        visited[i] = 0;
        for (int j = 1; j <= n; j++)
            graph[i][j] = INF;
    }

    for (int i = 0; i < m; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);
        graph[u][v] = w;
        graph[v][u] = w;
    }

    int source;
    scanf("%d", &source);

    dist[source] = 0;

    for (int count = 1; count <= n; count++) {
        int u = -1, mn = INF;

        for (int i = 1; i <= n; i++) {
            if (!visited[i] && dist[i] < mn) {
                mn = dist[i];
                u = i;
            }
        }

        if (u == -1) break;

        visited[u] = 1;

        for (int v = 1; v <= n; v++) {
            if (!visited[v] && graph[u][v] != INF &&
                dist[u] + graph[u][v] < dist[v]) {
                dist[v] = dist[u] + graph[u][v];
            }
        }
    }

    for (int i = 1; i <= n; i++)
        printf("%d ", dist[i]);

    return 0;
}
