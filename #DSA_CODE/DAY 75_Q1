#include <stdio.h>
#include <stdlib.h>

#define MAX 1000

// Simple structure for hashmap (using arrays for simplicity)
typedef struct {
    int sum;
    int index;
} Hash;

int maxLenZeroSumSubarray(int arr[], int n) {
    Hash hash[MAX];
    int size = 0;

    int sum = 0;
    int maxLen = 0;

    for (int i = 0; i < n; i++) {
        sum += arr[i];

        // Case 1: If sum is 0, update maxLen
        if (sum == 0) {
            maxLen = i + 1;
        }

        // Check if this sum is seen before
        int found = 0;
        for (int j = 0; j < size; j++) {
            if (hash[j].sum == sum) {
                int len = i - hash[j].index;
                if (len > maxLen)
                    maxLen = len;
                found = 1;
                break;
            }
        }

        // If not found, store it
        if (!found) {
            hash[size].sum = sum;
            hash[size].index = i;
            size++;
        }
    }

    return maxLen;
}

int main() {
    int arr[] = {15, -2, 2, -8, 1, 7, 10, 23};
    int n = sizeof(arr) / sizeof(arr[0]);

    int result = maxLenZeroSumSubarray(arr, n);

    printf("%d\n", result);

    return 0;
}
