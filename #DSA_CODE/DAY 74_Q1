#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX 1000
#define LEN 100

int cmp(const void *a, const void *b)
{
    return strcmp((char *)a, (char *)b);
}

int main()
{
    int n;
    scanf("%d", &n);

    char names[MAX][LEN];

    for (int i = 0; i < n; i++)
        scanf("%s", names[i]);

    qsort(names, n, sizeof(names[0]), cmp);

    int maxVotes = 1, count = 1;
    char winner[LEN];
    strcpy(winner, names[0]);

    for (int i = 1; i < n; i++)
    {
        if (strcmp(names[i], names[i - 1]) == 0)
            count++;
        else
            count = 1;

        if (count > maxVotes || (count == maxVotes && strcmp(names[i], winner) < 0))
        {
            maxVotes = count;
            strcpy(winner, names[i]);
        }
    }

    printf("%s %d", winner, maxVotes);

    return 0;
}
