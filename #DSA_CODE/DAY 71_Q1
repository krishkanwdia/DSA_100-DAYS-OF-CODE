#include <stdio.h>
#include <string.h>

#define EMPTY -1

void insert(int table[], int m, int key) {
    int hash = key % m;
    for (int i = 0; i < m; i++) {
        int idx = (hash + i * i) % m;
        if (table[idx] == EMPTY) {
            table[idx] = key;
            return;
        }
    }
}

void search(int table[], int m, int key) {
    int hash = key % m;
    for (int i = 0; i < m; i++) {
        int idx = (hash + i * i) % m;
        if (table[idx] == key) {
            printf("FOUND\n");
            return;
        }
        if (table[idx] == EMPTY) {
            break;
        }
    }
    printf("NOT FOUND\n");
}

int main() {
    int m, q;
    scanf("%d", &m);
    scanf("%d", &q);

    int table[m];
    for (int i = 0; i < m; i++)
        table[i] = EMPTY;

    char operation[10];
    int key;

    for (int i = 0; i < q; i++) {
        scanf("%s %d", operation, &key);
        if (strcmp(operation, "INSERT") == 0)
            insert(table, m, key);
        else if (strcmp(operation, "SEARCH") == 0)
            search(table, m, key);
    }

    return 0;
}
